<?xml version="1.0" encoding="utf-8"?>
<!-- Dados clínicos e chaves de API não saem do aparelho (LGPD). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="omnicase_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
